#!/bin/bash

# Install a Node.js version required in the project's `.nvmrc` file.
# > Note: Uses `bun` to manage Node.js versions.
#
# - Switch to a project’s Node.js version:
#
# `nnn`
#
# - Change the default Node.js version:
#
# `fnm default {{version}}`
#
# ---
# Author: Nick Plekhanov, https://plekhanov.me
# License: MIT
# https://github.com/nicksp/dotfiles

command -v bun &> /dev/null || {
  echo >&2 "bun is not installed: curl -fsSL https://bun.com/install | bash"
  exit 1
}

bun use --install-if-missing
